{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libretv-stillshadow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "vars": {
    "COOKIE_SECURE": "true",
    "REQUEST_TIMEOUT": "8000",
    "MAX_RETRIES": "1",
    "DEBUG": "false"
  },
  "secrets": {
    "required": ["PASSWORD", "PROXY_SECRET", "DEFAULT_SOURCES"]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "tv.stillshadow.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
